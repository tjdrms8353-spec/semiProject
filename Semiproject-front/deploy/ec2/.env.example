# Copy to deploy/ec2/.env and fill secrets on EC2. Do not commit the filled file.
APP_ENV=production
FRONTEND_ORIGINS=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_USERNAME=
# Compose reads this file as raw values. Paste the hash directly, without quotes.
ADMIN_PASSWORD_HASH=
TIDB_HOST=
TIDB_PORT=4000
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_DATABASE=
OPENAI_API_KEY=

# Leave local Windows OCR paths unset; the Linux image installs Tesseract kor/eng.

# Optional: use DATABASE_URL instead of the TIDB_* connection fields.
# DATABASE_URL=
# Optional mail settings, only if signup email delivery is needed.
# EMAIL_PROVIDER=
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
