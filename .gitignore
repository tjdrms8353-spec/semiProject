# Local settings and credentials
.vscode/
.env
.env.*
!.env.example

# Generated build checks and package caches
**/.codex-*/
**/.codex-*.log
**/.codex-*.json
**/node_modules/
**/dist/
**/.npm-cache/
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/.tmp/

# Keep authoring sources and downloaded archives locally.
# Runtime GLB files and textures in frontend/public remain versioned.
Semiproject-front/assets/downloads/
Semiproject-front/assets/blender/**/*.blend*
Semiproject-front/assets/blender/**/*.glb
Semiproject-front/assets/blender/*_drafts/
Semiproject-front/assets/blender/previews/
